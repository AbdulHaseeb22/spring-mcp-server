<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.abdulhaseeb22</groupId>
        <artifactId>spring-mcp-server</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>spring-mcp-sample</artifactId>
    <name>spring-mcp-sample</name>
    <description>Sample Spring Boot application using the MCP starter</description>

    <dependencies>
        <dependency>
            <groupId>io.github.abdulhaseeb22</groupId>
            <artifactId>spring-mcp-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackage into an executable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Pin to the new main class; avoids ambiguity with the
                         legacy com.example.mcp.sample.SampleApplication -->
                    <mainClass>io.github.abdulhaseeb22.mcp.sample.SampleApplication</mainClass>
                </configuration>
            </plugin>
            <!-- Emit parameter names into bytecode so McpToolScanner can use
                 them as fallback when @McpParam(name=…) is absent -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>