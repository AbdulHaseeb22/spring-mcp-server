<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>io.github.abdulhaseeb22</groupId>
    <artifactId>spring-mcp-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-mcp-server</name>
    <description>Spring MCP Server - Multi-module project</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-mcp.version>0.0.1-SNAPSHOT</spring-mcp.version>
    </properties>

    <modules>
        <module>spring-mcp-annotations</module>
        <module>spring-mcp-core</module>
        <module>spring-mcp-autoconfigure</module>
        <module>spring-mcp-starter</module>
        <module>spring-mcp-sample</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>io.github.abdulhaseeb22</groupId>
                <artifactId>spring-mcp-annotations</artifactId>
                <version>${spring-mcp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.abdulhaseeb22</groupId>
                <artifactId>spring-mcp-core</artifactId>
                <version>${spring-mcp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.abdulhaseeb22</groupId>
                <artifactId>spring-mcp-autoconfigure</artifactId>
                <version>${spring-mcp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.abdulhaseeb22</groupId>
                <artifactId>spring-mcp-starter</artifactId>
                <version>${spring-mcp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>